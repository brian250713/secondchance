---
import Layout from '../../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="收容所｜動物認領養查詢" base={base}>
    <div id="app">載入中…</div>
    <script type="module">
      const base = (document.querySelector('main').dataset.base || '').replace(/\/$/, '');
      const id = new URLSearchParams(location.search).get('id');
      const app = document.getElementById('app');
      const shelters = await (await fetch(`${base}/data/shelters.json`)).json();
      const s = shelters.find((x) => x.ID === id);
      if (!s) { app.textContent = '找不到收容所'; throw new Error('no shelter'); }
      const idx = await (await fetch(`${base}/data/search-index.json`)).json();
      const mine = idx.records.filter((r) => r.shelter === s.ShelterName || r.shelterId === s.ID);
      const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(s.Address || s.ShelterName)}`;
      app.innerHTML = `
        <div class="card">
          <h1>${s.ShelterName}</h1>
          <p>${s.CityName} ｜ ${s.Address} ｜ ${s.Phone}</p>
          <p>開放時間：${s.OpenTime || '未知'}</p>
          <p><a href="${mapUrl}" target="_blank" rel="noopener">地圖外連 →</a>
          ${s.Url ? ` · <a href="${s.Url}" target="_blank" rel="noopener">官方網站 →</a>` : ''}</p>
          <p>在養約 ${mine.length} 隻（僅供參考，被認養即下架有延遲屬正常）</p>
        </div>
        <div class="card">
          <h2>名下在養動物</h2>
          <select id="f-kind"><option value="">全部種類</option><option>狗</option><option>貓</option></select>
          <div class="grid" id="grid"></div>
        </div>
        <p>本站內容整理自政府開放資料，僅供查詢參考，不構成飼養或醫療建議。以主管機關公告為準。</p>`;
      const grid = document.getElementById('grid');
      const render = () => {
        const k = document.getElementById('f-kind').value;
        const list = mine.filter((r) => !k || r.kind === k || (k === '狗' && r.kind.includes('狗'))).slice(0, 200);
        grid.innerHTML = list.map((r) => `
          <div class="mini">
            <img loading="lazy" src="${r.photo}" onerror="this.style.display='none'" />
            <div>${r.variety || r.kind} · ${r.sex} · ${r.bodytype}</div>
            <div><a href="../animal/?id=${r.id}">詳情 →</a></div>
          </div>`).join('') || '目前無資料';
      };
      document.getElementById('f-kind').addEventListener('input', render);
      render();
    </script>
</Layout>
